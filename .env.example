# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env

# deployBlog.sh — Telegram notification on new posts.
# Token from @BotFather; chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
# after sending your bot any message.
TELEGRAM_BOT_TOKEN=123456:ABC-change-me
TELEGRAM_CHAT_ID=123456789

# Path, relative to the blog repo root, where post files live.
BLOG_POSTS_DIR=content/posts
