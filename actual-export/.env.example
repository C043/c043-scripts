# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env && chmod 600 .env
#
# Plain KEY=value only — no `export ` prefix. Node's .env parser would treat
# `export ACTUAL_SERVER_URL` as the literal key name.

# Sync server URL: protocol + host + port, no trailing slash.
ACTUAL_SERVER_URL=https://homeserver.example.ts.net:5006

# Sync server login password.
ACTUAL_PASSWORD=change-me

# Budget sync ID. Actual UI: Settings -> Advanced settings -> Sync ID.
ACTUAL_SYNC_ID=00000000-0000-0000-0000-000000000000

# Optional. Base directory holding cache/ and backups/.
# Defaults to ~/data when unset.
ACTUAL_BACKUP_DIR=/home/youruser/actual-backup
